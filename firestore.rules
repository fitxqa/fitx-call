rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() { return signedIn() && exists(myPath()) && get(myPath()).data.disabled != true; }
    function isAdmin() { return active() && get(myPath()).data.role == 'admin'; }
    function callOf(id) { return get(/databases/$(database)/documents/calls/$(id)).data; }
    function party(d) { return d.from == request.auth.uid || d.to == request.auth.uid; }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    // First-time setup: the very first signed-in person may make themselves admin, once.
    function bootstrapping() { return signedIn() && !exists(setupPath()) && existsAfter(setupPath()); }

    match /config/setup {
      allow read: if true;
      allow create: if bootstrapping()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Username -> hidden login email. Read before sign-in; only admins change it.
    match /usernames/{name} {
      allow read: if true;
      allow write: if isAdmin() || bootstrapping();
    }

    // Employee directory. Admins manage it; employees may only update their own presence fields.
    match /users/{uid} {
      allow read: if active();
      allow create: if isAdmin() || (bootstrapping() && request.auth.uid == uid && request.resource.data.role == 'admin');
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (active() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'platform', 'appVersion']));

      // Personal call history ("Recents").
      match /log/{callId} {
        allow read, delete: if active() && request.auth.uid == uid;
        allow create, update: if active()
          && (request.auth.uid == uid || (party(callOf(callId)) && (callOf(callId).from == uid || callOf(callId).to == uid)));
      }
    }

    // Calls: only the two people in a call can see or change it.
    match /calls/{callId} {
      allow create: if active()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'ringing'
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to));
      allow read: if active() && party(resource.data);
      allow update: if active() && party(resource.data)
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;

      match /{side}/{candId} {
        allow read, create: if active()
          && (side == 'callerCandidates' || side == 'calleeCandidates')
          && party(callOf(callId));
      }
    }

    // Chats: one per pair of employees, id = "<uidA>_<uidB>" (sorted). Only the two members can see it.
    function chatOf(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function inChat(id) { return request.auth.uid in chatOf(id).members; }

    match /chats/{chatId} {
      allow read: if active() && request.auth.uid in resource.data.members;
      allow create: if active()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if active() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      match /messages/{msgId} {
        allow read: if active() && inChat(chatId);
        allow create: if active() && inChat(chatId) && request.resource.data.from == request.auth.uid;
        allow delete: if active() && resource.data.from == request.auth.uid;
      }
    }

    // Photos / voice / video, split into ~900 KB parts (free plan has no file Storage).
    match /media/{mediaId} {
      allow read: if active() && inChat(resource.data.chatId);
      allow create: if active() && request.resource.data.owner == request.auth.uid && inChat(request.resource.data.chatId);
      allow delete: if active() && resource.data.owner == request.auth.uid;

      match /parts/{part} {
        allow read: if active() && inChat(get(/databases/$(database)/documents/media/$(mediaId)).data.chatId);
        allow create: if active() && get(/databases/$(database)/documents/media/$(mediaId)).data.owner == request.auth.uid;
      }
    }
  }
}
